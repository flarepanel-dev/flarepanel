{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flarepanel-dashboard",
  "main": "server/index.js",
  "compatibility_date": "2026-11-25",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": [
        "**/*.js",
        "**/*.mjs"
      ]
    }
  ],
  "assets": {
    "directory": "client"
  },
  "workers_dev": true,
  "limits": {
    "cpu_ms": 10000
  },
  "vars": {
    "NODE_ENV": "production",
    "SELF_HOSTED": "true",
    "APP_VERSION": "1.0.0"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
