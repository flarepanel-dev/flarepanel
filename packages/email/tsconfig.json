{
  "extends": "@flarepanel/tsconfig/base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/server/*": ["./src/server/*"]
    },
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo.json",
    "strictNullChecks": true,
    // Automatic runtime: bundlers (wrangler/esbuild) follow this, and the
    // templates do not import React themselves.
    "jsx": "react-jsx"
  },
  "include": ["."],
  "exclude": ["node_modules"]
}
