{
  "name": "flarepanel-platform-test",
  "main": "./worker.ts",
  "compatibility_date": "2026-03-10",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "COORDINATOR", "class_name": "CoordinatorDurableObject" },
      { "name": "PUBSUB_HUB", "class_name": "PubSubHubDurableObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CoordinatorDurableObject"] },
    { "tag": "v2", "new_sqlite_classes": ["PubSubHubDurableObject"] }
  ]
}
