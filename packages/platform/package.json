{
  "name": "@flarepanel/platform",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/contract.ts",
    "./cloudflare": "./src/cloudflare/index.ts"
  },
  "scripts": {
    "test": "bun test src/memory.test.ts",
    "test:cloudflare": "vitest run --config vitest.cloudflare.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.cloudflare.json"
  },
  "devDependencies": {
    "@flarepanel/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "@cloudflare/vitest-pool-workers": "0.12.21",
    "@cloudflare/workers-types": "5.20261121.1",
    "vitest": "3.1.3",
    "bun-types": "1.4.4"
  }
}
