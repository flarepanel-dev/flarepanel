{
  "$schema": "node_modules/wrangler/config-schema.json",
  // flarepanel.dev, the hosted service. Deploy with `bun run deploy:hosted`.
  // Self-hosting starts from wrangler.jsonc next to this file instead.
  "account_id": "cb2d46c65b7c8fe69cb77e78b36d3c9e",
  "name": "flarepanel-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-25",
  // legacy_module_registry: the module registry that is the default from
  // 2026-11-17 roughly doubles startup CPU for this ~23 MB bundle, and
  // Cloudflare then refuses the deploy (startup CPU limit). Drop it once
  // the bundle is smaller; `wrangler check startup` measures it.
  "compatibility_flags": ["nodejs_compat", "legacy_module_registry"],
  // Production: api.flarepanel.dev. Local: `bun run dev` with .dev.vars
  // overriding the vars below (Miniflare, free).
  "routes": [{ "pattern": "api.flarepanel.dev", "custom_domain": true }],
  // Per-Worker cost cap: at most 10 s CPU per invocation.
  "limits": { "cpu_ms": 10000 },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flarepanel",
      "database_id": "6c5754e3-81e9-40ce-9112-2608ee72a257",
      "migrations_dir": "../../packages/db/migrations"
    },
    // IP geolocation (DB-IP City Lite, CC BY 4.0), loaded and refreshed
    // monthly by the API itself. Optional: remove to turn GeoIP off.
    {
      "binding": "GEO_DB",
      "database_name": "flarepanel-geo",
      "database_id": "5e7820f8-43e9-42bb-9842-0d1929dec17d"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "COORDINATOR", "class_name": "CoordinatorDurableObject" },
      { "name": "PUBSUB_HUB", "class_name": "PubSubHubDurableObject" },
      // One per project: its events, sessions, rollups and live sockets.
      { "name": "PROJECT_EVENTS", "class_name": "ProjectEventsDurableObject" },
      { "name": "BASIN_USAGE", "class_name": "BasinUsageDurableObject" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "CoordinatorDurableObject",
        "PubSubHubDurableObject"
      ]
    },
    { "tag": "v2", "new_sqlite_classes": ["ProjectEventsDurableObject"] },
    { "tag": "v3", "new_sqlite_classes": ["BasinUsageDurableObject"] }
  ],
  // Raw event archive (ndjson.gz per project and hour). Without this binding
  // the Worker runs in lite mode: no archive, 30-day retention.
  "r2_buckets": [
    { "binding": "EVENTS_ARCHIVE", "bucket_name": "flarepanel-events" }
  ],
  // Cloudflare Email Service: account emails (sign-up, invites, password
  // reset, alerts). 3,000/month are included in Workers Paid. The sender
  // domain must be onboarded under Email Service > Email Sending.
  "send_email": [{ "name": "EMAIL" }],
  // Dynamic Workers: JavaScript webhook templates run sandboxed here (no
  // network, 50 ms CPU). One template is one Dynamic Worker a day.
  "worker_loaders": [{ "binding": "LOADER" }],
  // Per-IP caps enforced before the app or any Durable Object runs:
  // /track and /event, and /mcp. The app also limits /mcp per token (60/min)
  // and per IP (3000/min); this cheaper edge cap cuts guessing with rotating
  // fake tokens from one address. It stays high because hosted AI clients
  // share egress addresses across many users.
  "ratelimits": [
    {
      "name": "TRACK_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 600, "period": 60 }
    },
    {
      "name": "MCP_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 600, "period": 60 }
    }
  ],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "flarepanel-jobs" }],
    "consumers": [
      {
        "queue": "flarepanel-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "max_concurrency": 2,
        "dead_letter_queue": "flarepanel-jobs-dlq"
      },
      // Jobs Queues gave up on: kept in R2 under dead-letters/ and alerted.
      { "queue": "flarepanel-jobs-dlq", "max_batch_size": 10, "max_retries": 3 }
    ]
  },
  "triggers": { "crons": ["* * * * *"] },
  // Node-only dependencies swapped for Worker versions or loud stand-ins.
  "alias": {
    "@flarepanel/db/src/prisma-client": "../../packages/db/src/prisma-client.workerd.ts",
    "@clickhouse/client": "@clickhouse/client-web",
    "@node-rs/argon2": "./src/shims/argon2.ts",
    "ioredis": "./src/shims/ioredis.ts",
    "bullmq": "./src/shims/bullmq.ts",
    "kafkajs": "./src/shims/kafkajs.ts",
    "nodemailer": "./src/shims/nodemailer.ts",
    "pino": "./src/shims/pino.ts",
    "@hyperdx/node-opentelemetry": "./src/shims/hyperdx.ts",
    "@slack/bolt": "./src/shims/empty-module.ts",
    "@google-cloud/storage": "./src/shims/empty-module.ts",
    "@maxmind/geoip2-node": "./src/shims/empty-module.ts",
    "unzipper": "./src/shims/empty-module.ts"
  },
  "vars": {
    "NODE_ENV": "production",
    "SELF_HOSTED": "true",
    // Sign-ups closed until launch; invited users can still join.
    "ALLOW_REGISTRATION": "false",
    "API_URL": "https://api.flarepanel.dev",
    "DASHBOARD_URL": "https://dashboard.flarepanel.dev",
    "CUSTOM_COOKIE_DOMAIN": ".flarepanel.dev",
    // Cloudflare sets cf-connecting-ip itself; clients cannot spoof it.
    "TRUSTED_IP_HEADER_ORDER": "cf-connecting-ip",
    // Hot events kept in each project's Durable Object; R2 keeps them all.
    "FLAREPANEL_EVENT_RETENTION_DAYS": "90",
    // Checked every 5 minutes by the cron; failures email OPS_ALERT_EMAIL.
    "UPTIME_URLS": "https://dashboard.flarepanel.dev/login,https://docs.flarepanel.dev/,https://flarepanel.dev/",
    // "Give feedback" in the dashboard emails here (forwarded to the team);
    // with the FEEDBACK_GITHUB_TOKEN secret it also opens a GitHub issue.
    "FEEDBACK_EMAIL": "hello@flarepanel.dev"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    // Traces: request timelines (DO calls, D1 queries, fetches). 10% of
    // requests, which is ~0.1 GB a month at today's traffic, inside the
    // account's 50 GB Observability allowance (pricing from 2026-12-01).
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
