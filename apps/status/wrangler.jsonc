{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // status.flarepanel.dev. Hosted only: it watches flarepanel.dev's own
  // services and shares no binding, database or code with them, so it stays up
  // (and says so) when they are down.
  "account_id": "cb2d46c65b7c8fe69cb77e78b36d3c9e",
  "name": "flarepanel-status",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-25",
  // Reports AI crawler visits to the status project (secret set with
  // `wrangler secret put FLAREPANEL_CLIENT_SECRET`).
  "vars": { "FLAREPANEL_CLIENT_ID": "069e45a1-5b97-417f-9c4f-fbbbe6a16938" },
  "routes": [{ "pattern": "status.flarepanel.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // Every minute: about 43,000 runs and 6 checks each per month, well inside
  // the Workers Paid plan.
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flarepanel-status",
      "database_id": "4bc5d7e5-3c87-4750-8bdc-1b2e50b3dc9a",
      "migrations_dir": "migrations"
    }
  ],
  // Email updates to subscribers (Cloudflare Email Service; the sender domain
  // flarepanel.dev is already onboarded for the API's account emails). Counts
  // toward the same 3,000 included emails a month.
  "send_email": [{ "name": "EMAIL" }],
  // Operator push: `wrangler secret put OPS_ALERT_NTFY_URL` (an ntfy topic
  // address). An automatic incident then pushes when it opens and resolves.
  // Fonts and the icon; every other path runs the Worker.
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
