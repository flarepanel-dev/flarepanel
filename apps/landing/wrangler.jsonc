{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Static-assets-only Worker: no `main`, so every request is served from
  // `out/` without running Worker code (static asset requests are free).
  "name": "flarepanel-landing",
  "compatibility_date": "2026-03-10",
  "assets": {
    "directory": "./out",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "flarepanel.dev", "custom_domain": true },
    { "pattern": "www.flarepanel.dev", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false }
}
