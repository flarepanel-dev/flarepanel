{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "flarepanel-docs",
  // Pages are served from static assets. Page requests first pass a tiny
  // Worker that reports AI crawler visits to FlarePanel (worker/index.ts);
  // scripts, styles, images and fonts skip it and stay free.
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-25",
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/assets/*", "!/fonts/*", "!/*.png", "!/*.svg", "!/*.ico", "!/*.woff2", "!/*.css", "!/*.js"],
    "directory": "./dist/public",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "docs.flarepanel.dev", "custom_domain": true }],
  "vars": { "FLAREPANEL_CLIENT_ID": "f7c816f0-bdf1-4b99-9e3f-62d4d187d9ad" },
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false }
}
