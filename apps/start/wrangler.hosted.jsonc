{
  "$schema": "node_modules/wrangler/config-schema.json",
  // flarepanel.dev, the hosted service. Deploy with `bun run deploy:hosted`.
  // Self-hosting starts from wrangler.jsonc next to this file instead.
  "account_id": "cb2d46c65b7c8fe69cb77e78b36d3c9e",
  "name": "flarepanel-dashboard",
  "compatibility_date": "2026-03-10",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "routes": [{ "pattern": "dashboard.flarepanel.dev", "custom_domain": true }],
  // Per-Worker cost cap .
  "limits": { "cpu_ms": 10000 },
  "vars": {
    "API_URL": "https://api.flarepanel.dev",
    "DASHBOARD_URL": "https://dashboard.flarepanel.dev",
    "NODE_ENV": "production",
    "APP_VERSION": "1.0.0"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "invocation_logs": true
    },
    // 10% of requests traced; tiny at today's traffic (see apps/worker).
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
