# FlarePanel on your own server. Copy to `.env` next to docker-compose.yml.

# Public addresses, as browsers reach them. With the bundled proxy these are
# https://DASHBOARD_HOST and https://API_HOST.
DASHBOARD_URL=https://analytics.example.com
API_URL=https://api.analytics.example.com

# Hostnames for the bundled Caddy proxy (`docker compose --profile proxy up -d`).
DASHBOARD_HOST=analytics.example.com
API_HOST=api.analytics.example.com

# The dashboard and the API are on different hostnames, so the sign-in cookie
# needs the domain they share, with a leading dot.
CUSTOM_COOKIE_DOMAIN=.analytics.example.com

# Two secrets, each from: openssl rand -hex 32
# COOKIE_SECRET signs sessions. ENCRYPTION_KEY protects stored keys (AI
# providers, integrations): losing it makes them unreadable.
COOKIE_SECRET=
ENCRYPTION_KEY=

# Sign-ups. With `false` the first account can still register and everyone
# after that needs an invitation. `true`, or empty, lets anyone register.
ALLOW_REGISTRATION=false

# Email (optional): invitations, password resets, digests. SMTP or Resend.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
RESEND_API_KEY=
EMAIL_SENDER=

# AI features (optional): a server-wide key. Workspaces can also add their own.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Once a day the server reports its dashboard address and total event count
# to api.flarepanel.dev. Set to true to turn that off.
DISABLE_PING=

# Images: the names you built them with (see README.md).
FLAREPANEL_API_IMAGE=flarepanel-api:local
FLAREPANEL_DASHBOARD_IMAGE=flarepanel-dashboard:local

# Where the containers listen on the host when you bring your own proxy.
API_BIND=127.0.0.1:3333
DASHBOARD_BIND=127.0.0.1:3300
REDPANDA_MEMORY=1G
