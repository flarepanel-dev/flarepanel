{
  "name": "@flarepanel/root",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Carl-Gerhard Lindesvärd",
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=24.22.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": ">=1.4.4",
      "onFail": "warn"
    }
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/**",
      "tooling/*"
    ],
    "catalog": {
      "zod": "4.6.7",
      "react": "19.2.3",
      "@types/react": "19.2.7",
      "react-dom": "19.2.3",
      "@types/react-dom": "19.2.3",
      "@types/node": "24.10.1",
      "typescript": "5.9.3",
      "pino": "10.3.1",
      "pino-pretty": "13.1.3",
      "@hyperdx/node-opentelemetry": "0.10.3"
    }
  },
  "patchedDependencies": {
    "@polar-sh/sdk@0.49.0": "patches/@polar-sh__sdk.patch",
    "react-grid-layout@2.3.0": "patches/react-grid-layout@2.3.0.patch",
    "elysia@1.4.30": "patches/elysia@1.4.30.patch"
  },
  "overrides": {
    "esm-env": "npm:esm-env-runtime@^0.1.0",
    "seroval": "1.8.2",
    "seroval-plugins": "1.8.0",
    "embla-carousel": "8.0.0-rc22",
    "express": "4.19.2",
    "h3": "1.15.4",
    "nuxt": "4.2.2",
    "react-native": "0.73.6",
    "expo-application": "5.3.1",
    "expo-constants": "15.4.5",
    "lucide-react@^1.7.0": "0.555.0",
    "framer-motion@^12.40.0": "12.40.0",
    "motion-dom@^12.23.23": "12.40.0",
    "vue": "3.5.25"
  },
  "scripts": {
    "test": "bun run test:core && bun run test:rest",
    "test:core": "bun run --filter @flarepanel/core test",
    "security:isolation": "cd packages/core && bun --preload ./test/preload.ts ../../scripts/security/tenant-isolation.ts --api http://localhost:8787 --origin http://localhost:3000 --report ../../security-isolation-report.md",
    "test:rest": "bun run --filter @flarepanel/db test && bun run --filter @flarepanel/platform test && bun run --filter @flarepanel/api test && bun run --filter @flarepanel/seed test && bun run --filter @flarepanel/web test && bun run --filter start test && bun run --filter @flarepanel/release test && vitest run && bun test tooling/gates/conformance",
    "gen:bots": "bun run --filter @flarepanel/core gen:bots",
    "gen:referrers": "bun run --filter @flarepanel/core gen:referrers",
    "dock:up": "docker compose up -d",
    "dock:down": "docker compose down",
    "dock:kafka-auth": "docker compose --profile kafka-auth up -d --wait op-rp-auth",
    "dock:ch": "docker compose exec -it op-ch clickhouse-client -d openpanel",
    "dock:redis": "docker compose exec -it op-kv redis-cli",
    "db:codegen": "bun run --filter @flarepanel/db codegen",
    "codegen": "bun run --filter @flarepanel/db codegen && bun run --filter @flarepanel/core codegen",
    "migrate": "bun run --filter @flarepanel/db migrate",
    "migrate:deploy": "bun run --filter @flarepanel/db migrate:deploy",
    "seed": "bun run --filter @flarepanel/seed seed --",
    "send": "bun run --filter @flarepanel/seed send --",
    "e2e": "bun run --filter start e2e --",
    "postinstall:workspaces": "bun run --filter @flarepanel/testbed postinstall",
    "dev": "bun run --filter @flarepanel/api testing & bun run --filter start dev & wait",
    "typecheck": "bun tooling/scripts/typecheck-workspaces.ts",
    "check:public": "bun tooling/scripts/public-check.ts",
    "update-simple-git-hooks": "npx simple-git-hooks",
    "check:workspace": "bunx sherif@1.13.0",
    "check:deps": "depcruise --config .dependency-cruiser.cjs --output-type err apps/start packages",
    "check": "ultracite check && bun run check:deps",
    "lint": "ultracite check",
    "lint:format": "ultracite check --linter-enabled=false",
    "fix": "ultracite fix"
  },
  "simple-git-hooks": {
    "pre-push": "sh tooling/scripts/pre-push.sh"
  },
  "dependencies": {
    "@hyperdx/node-opentelemetry": "catalog:",
    "dotenv-cli": "7.3.0",
    "semver": "7.6.0",
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.15",
    "depcheck": "1.4.7",
    "dependency-cruiser": "18.2.0",
    "simple-git-hooks": "2.12.1",
    "ultracite": "7.2.0",
    "vitest": "3.1.3"
  }
}
